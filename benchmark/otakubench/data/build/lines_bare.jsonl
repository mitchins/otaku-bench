{"challenge": "ellipsis_coreference", "difficulty": 1, "id": "JMB-001", "japanese": "先に行ってて。", "split": "dev"}
{"challenge": "ellipsis_coreference", "difficulty": 1, "id": "JMB-002", "japanese": "もういい。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 1, "id": "JMB-003", "japanese": "あっちは任せた。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 1, "id": "JMB-004", "japanese": "で、どうする？", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 1, "id": "JMB-005", "japanese": "それ、私の。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 2, "id": "JMB-006", "japanese": "帰れると思った。", "split": "dev"}
{"challenge": "ellipsis_coreference", "difficulty": 2, "id": "JMB-007", "japanese": "残り三分。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 2, "id": "JMB-008", "japanese": "そっちじゃない！", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 2, "id": "JMB-009", "japanese": "言わなくても、分かるでしょ。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 2, "id": "JMB-010", "japanese": "大丈夫なはずだった。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 3, "id": "JMB-011", "japanese": "撃ったのは、誰だ。", "split": "dev"}
{"challenge": "ellipsis_coreference", "difficulty": 3, "id": "JMB-012", "japanese": "そこまで言う？", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 3, "id": "JMB-013", "japanese": "まだ、いる？", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 3, "id": "JMB-014", "japanese": "いなくなったのは一人だけじゃなかった。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 3, "id": "JMB-015", "japanese": "鍵なら、預かってる。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 4, "id": "JMB-016", "japanese": "それで済むと思ってるの？", "split": "dev"}
{"challenge": "ellipsis_coreference", "difficulty": 4, "id": "JMB-017", "japanese": "好きだった。今も、たぶん。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 4, "id": "JMB-018", "japanese": "勝ったからって、終わりじゃない。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 4, "id": "JMB-019", "japanese": "ここで待てって、誰が言った？", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 4, "id": "JMB-020", "japanese": "行けるなら行ってたよ。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 5, "id": "JMB-021", "japanese": "見えていたのに、見ていなかった。", "split": "dev"}
{"challenge": "ellipsis_coreference", "difficulty": 5, "id": "JMB-022", "japanese": "彼女の「いいよ」は、どっちの意味だったんだ。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 5, "id": "JMB-023", "japanese": "これを渡せば、あの人は……いや、やめよう。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 5, "id": "JMB-024", "japanese": "泣いたのは負けたからじゃない。勝ったからでもない。", "split": "eval"}
{"challenge": "ellipsis_coreference", "difficulty": 5, "id": "JMB-025", "japanese": "「戻る」と言った。どこへとは、一度も。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 1, "id": "JMB-026", "japanese": "少々お待ちください。", "split": "dev"}
{"challenge": "keigo_politeness", "difficulty": 1, "id": "JMB-027", "japanese": "こちらへどうぞ。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 1, "id": "JMB-028", "japanese": "ご用件は？", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 1, "id": "JMB-029", "japanese": "お先に失礼します。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 1, "id": "JMB-030", "japanese": "お名前を伺ってもよろしいですか。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 2, "id": "JMB-031", "japanese": "先生がお見えになりました。", "split": "dev"}
{"challenge": "keigo_politeness", "difficulty": 2, "id": "JMB-032", "japanese": "私がご案内いたします。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 2, "id": "JMB-033", "japanese": "ご確認いただけますでしょうか。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 2, "id": "JMB-034", "japanese": "お聞きしても差し支えありませんか。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 2, "id": "JMB-035", "japanese": "本日はお足元の悪い中、ありがとうございます。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 3, "id": "JMB-036", "japanese": "部長はすでに戻っております。", "split": "dev"}
{"challenge": "keigo_politeness", "difficulty": 3, "id": "JMB-037", "japanese": "その件は承知しております。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 3, "id": "JMB-038", "japanese": "恐れ入りますが、こちらではお受けできません。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 3, "id": "JMB-039", "japanese": "お預かりしていた品をお返しに参りました。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 3, "id": "JMB-040", "japanese": "ご無理をなさらないでください。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 4, "id": "JMB-041", "japanese": "差し出がましいようですが、一言よろしいでしょうか。", "split": "dev"}
{"challenge": "keigo_politeness", "difficulty": 4, "id": "JMB-042", "japanese": "お言葉ですが、その判断には賛同しかねます。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 4, "id": "JMB-043", "japanese": "ご厚意はありがたいのですが、お受けするわけにはまいりません。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 4, "id": "JMB-044", "japanese": "お召し上がりにならなかった理由を伺っても？", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 4, "id": "JMB-045", "japanese": "お取り計らいいただいたこと、重々承知しております。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 5, "id": "JMB-046", "japanese": "お目にかかるのは、これが最後かと存じます。", "split": "dev"}
{"challenge": "keigo_politeness", "difficulty": 5, "id": "JMB-047", "japanese": "ご存じだったのなら、なぜ黙っていらっしゃったのですか。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 5, "id": "JMB-048", "japanese": "申し上げにくいのですが、殿下のお考えには見落としがございます。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 5, "id": "JMB-049", "japanese": "ご辞退なさるおつもりでしたら、なぜ今朝お引き受けになったのでしょう。", "split": "eval"}
{"challenge": "keigo_politeness", "difficulty": 5, "id": "JMB-050", "japanese": "お言葉を返すようで恐縮ですが、その沈黙を同意と受け取ることはできかねます。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 1, "id": "JMB-051", "japanese": "今日は猫の手も借りたい。", "split": "dev"}
{"challenge": "idiom_proverb", "difficulty": 1, "id": "JMB-052", "japanese": "首を長くして待ってたよ。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 1, "id": "JMB-053", "japanese": "あの子、口が堅いから。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 1, "id": "JMB-054", "japanese": "明日の試合を思うと気が重い。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 1, "id": "JMB-055", "japanese": "たまには羽を伸ばそう。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 2, "id": "JMB-056", "japanese": "その件は水に流そう。", "split": "dev"}
{"challenge": "idiom_proverb", "difficulty": 2, "id": "JMB-057", "japanese": "彼は裏社会でも顔が広い。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 2, "id": "JMB-058", "japanese": "今回だけは目をつぶる。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 2, "id": "JMB-059", "japanese": "正論すぎて耳が痛いよ。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 2, "id": "JMB-060", "japanese": "あの人には頭が上がらない。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 3, "id": "JMB-061", "japanese": "この橋を一晩で直すのは骨が折れるぞ。", "split": "dev"}
{"challenge": "idiom_proverb", "difficulty": 3, "id": "JMB-062", "japanese": "また油を売ってる場合か！", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 3, "id": "JMB-063", "japanese": "足を洗ったはずの男が、また賭場にいた。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 3, "id": "JMB-064", "japanese": "先に釘を刺しておく。余計なことはするな。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 3, "id": "JMB-065", "japanese": "問い詰めたら、冗談で煙に巻かれた。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 4, "id": "JMB-066", "japanese": "昔ひどいことを言ったから、あの家は敷居が高い。", "split": "dev"}
{"challenge": "idiom_proverb", "difficulty": 4, "id": "JMB-067", "japanese": "彼女は先生の前でだけ猫をかぶる。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 4, "id": "JMB-068", "japanese": "そこで本当のことを言うなんて、火に油だ。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 4, "id": "JMB-069", "japanese": "返事が煮え切らないのは、何か隠してるから？", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 4, "id": "JMB-070", "japanese": "下手に探りを入れたら藪蛇になる。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 5, "id": "JMB-071", "japanese": "村の消滅は、青天の霹靂だった。", "split": "dev"}
{"challenge": "idiom_proverb", "difficulty": 5, "id": "JMB-072", "japanese": "背に腹は代えられない。敵に頭を下げよう。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 5, "id": "JMB-073", "japanese": "風の便りに、あの人が帰ってきたと聞いた。本人からは、まだ何も。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 5, "id": "JMB-074", "japanese": "勝ち馬と見るや、連中は手のひらを返した。", "split": "eval"}
{"challenge": "idiom_proverb", "difficulty": 5, "id": "JMB-075", "japanese": "王の過去を暴くのは虎の尾を踏むようなものだ。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 1, "id": "JMB-076", "japanese": "今日はちょっと……。", "split": "dev"}
{"challenge": "indirectness_pragmatics", "difficulty": 1, "id": "JMB-077", "japanese": "それはまた今度ね。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 1, "id": "JMB-078", "japanese": "考えておくよ。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 1, "id": "JMB-079", "japanese": "悪くはないけど。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 1, "id": "JMB-080", "japanese": "もう遅いし、そろそろ。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 2, "id": "JMB-081", "japanese": "その話は食事のあとにしようか。", "split": "dev"}
{"challenge": "indirectness_pragmatics", "difficulty": 2, "id": "JMB-082", "japanese": "君に任せるよ、責任も含めて。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 2, "id": "JMB-083", "japanese": "ずいぶん立派な言い訳だね。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 2, "id": "JMB-084", "japanese": "別に嫌いとは言ってない。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 2, "id": "JMB-085", "japanese": "お茶でも、と思ったんですが……。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 3, "id": "JMB-086", "japanese": "ご期待に添えるかどうか。", "split": "dev"}
{"challenge": "indirectness_pragmatics", "difficulty": 3, "id": "JMB-087", "japanese": "もう少し静かだと助かるんだけど。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 3, "id": "JMB-088", "japanese": "お前にしては上出来だ。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 3, "id": "JMB-089", "japanese": "ご検討いただければ幸いです。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 3, "id": "JMB-090", "japanese": "前向きに検討させていただきます。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 4, "id": "JMB-091", "japanese": "来られる人だけで始めよう。", "split": "dev"}
{"challenge": "indirectness_pragmatics", "difficulty": 4, "id": "JMB-092", "japanese": "期待してないわけじゃないんだけどね。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 4, "id": "JMB-093", "japanese": "その発想はなかった。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 4, "id": "JMB-094", "japanese": "あなたらしい選択ですね。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 4, "id": "JMB-095", "japanese": "止めはしない。ただ、帰る場所は残しておけ。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 5, "id": "JMB-096", "japanese": "ご立派なお考えです。現場さえご覧にならなければ。", "split": "dev"}
{"challenge": "indirectness_pragmatics", "difficulty": 5, "id": "JMB-097", "japanese": "私が聞きたいのは、できるかどうかじゃありません。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 5, "id": "JMB-098", "japanese": "それ、誰にでも言ってるんでしょう？", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 5, "id": "JMB-099", "japanese": "ご都合のいい時だけ家族扱いとは、ありがたい話です。", "split": "eval"}
{"challenge": "indirectness_pragmatics", "difficulty": 5, "id": "JMB-100", "japanese": "今さら謝られても、昨日の私には届かないんだよ。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 1, "id": "JMB-101", "japanese": "ほんまに？", "split": "dev"}
{"challenge": "dialect_character_voice", "difficulty": 1, "id": "JMB-102", "japanese": "あかん、間に合わへん。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 1, "id": "JMB-103", "japanese": "なんでやねん！", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 1, "id": "JMB-104", "japanese": "せやな、今日は帰ろか。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 1, "id": "JMB-105", "japanese": "うち、そんなん聞いてへんで。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 2, "id": "JMB-106", "japanese": "これ、なんぼするん？", "split": "dev"}
{"challenge": "dialect_character_voice", "difficulty": 2, "id": "JMB-107", "japanese": "勝手に触らんといて。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 2, "id": "JMB-108", "japanese": "それ、お前が言うんかい。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 2, "id": "JMB-109", "japanese": "知らんけど、たぶん向こうやで。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 2, "id": "JMB-110", "japanese": "先に食べとき。冷めてまうで。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 3, "id": "JMB-111", "japanese": "拙者にお任せあれ。", "split": "dev"}
{"challenge": "dialect_character_voice", "difficulty": 3, "id": "JMB-112", "japanese": "おいらはまだ諦めねえ。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 3, "id": "JMB-113", "japanese": "この俺様に指図する気か？", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 3, "id": "JMB-114", "japanese": "わしには分からんこともある。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 3, "id": "JMB-115", "japanese": "あたし、別に怖くなんかないし。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 4, "id": "JMB-116", "japanese": "ほんなら、約束破ったらあかんで。", "split": "dev"}
{"challenge": "dialect_character_voice", "difficulty": 4, "id": "JMB-117", "japanese": "そげん慌てんでもよかよ。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 4, "id": "JMB-118", "japanese": "ここに置いとるけん、忘れんでね。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 4, "id": "JMB-119", "japanese": "そんなこと言うとらん。最後まで聞け。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 4, "id": "JMB-120", "japanese": "わらわを誰と心得る。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 5, "id": "JMB-121", "japanese": "～でござる、って今どき誰が言うのよ。", "split": "dev"}
{"challenge": "dialect_character_voice", "difficulty": 5, "id": "JMB-122", "japanese": "行く末を案ずるな。己が道を選べ。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 5, "id": "JMB-123", "japanese": "妾が許したとて、民が許すとは限らぬ。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 5, "id": "JMB-124", "japanese": "知らんけど、で済む話やないやろ。", "split": "eval"}
{"challenge": "dialect_character_voice", "difficulty": 5, "id": "JMB-125", "japanese": "わっちは売り買いの値より、誰が払うかを見とるんよ。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 1, "id": "JMB-126", "japanese": "「イルカはいるか？」って、今それ言う？", "split": "dev"}
{"challenge": "wordplay_irony", "difficulty": 1, "id": "JMB-127", "japanese": "彼は笑った。「布団が吹っ飛んだ、だって」", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 1, "id": "JMB-128", "japanese": "「カエルが帰る」？　はいはい、次。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 1, "id": "JMB-129", "japanese": "あの人、冗談だけは一級品だよ。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 1, "id": "JMB-130", "japanese": "笑うところ、そこじゃない。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 2, "id": "JMB-131", "japanese": "「選択」と「洗濯」を間違えて、人生が変わった。", "split": "dev"}
{"challenge": "wordplay_irony", "difficulty": 2, "id": "JMB-132", "japanese": "神に祈れと言ったら、紙を持ってきた。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 2, "id": "JMB-133", "japanese": "橋の端に箸を置くな。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 2, "id": "JMB-134", "japanese": "あの「やさしい」は、優しいじゃなくて易しいだ。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 2, "id": "JMB-135", "japanese": "彼の「冗談だよ」は、いつも笑えない。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 3, "id": "JMB-136", "japanese": "敵の本拠地が『安全第一』って名前なの、どうなの。", "split": "dev"}
{"challenge": "wordplay_irony", "difficulty": 3, "id": "JMB-137", "japanese": "その場で「空気を読め」って叫ぶの、空気読めてないよ。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 3, "id": "JMB-138", "japanese": "「負けるが勝ち」って、負けた人の言い訳じゃないの？", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 3, "id": "JMB-139", "japanese": "「適当でいい」と「適当にやれ」は、同じじゃない。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 3, "id": "JMB-140", "japanese": "「はい」は一回でいい、と言われて二回うなずいた。", "split": "eval"}
{"challenge": "wordplay_irony", "difficulty": 4, "id": "JMB-141", "japanese": "「できない」じゃない。「やらない」だろ。", "split": "dev"}
